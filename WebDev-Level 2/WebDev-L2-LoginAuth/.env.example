# Copy this file to ".env" (optional: every value has a sensible default).

# Port for the Express API (Vite's dev server proxies /api to it)
PORT=4000

# Storage: "sqlite" (default, file server/data/auraauth.db) or "json" (simple file, sessions in memory)
# SQLite uses Node's built-in module, so you need Node.js 22.13 or newer (check with: node -v).
# On an older Node the server automatically falls back to the JSON file and tells you so.
STORE=sqlite
# DB_FILE=server/data/auraauth.db

# bcrypt cost factor (higher = slower to brute-force, but slower to log in). 12 is a good default.
BCRYPT_ROUNDS=12

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Per-account lockout: after this many wrong passwords the account is locked for LOGIN_LOCK_MINUTES
# (the lock doubles on repeats, up to 1 hour)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Breached-password check using Have I Been Pwned (free, k-anonymity: only a 5-char hash prefix is sent).
#   BREACH_CHECK=off          -> disable the online lookup (the built-in common-password list still applies)
#   BREACH_FAIL_MODE=open     -> if the breach service is unreachable, still allow sign-up (default)
#   BREACH_FAIL_MODE=closed   -> if it is unreachable, refuse sign-up until it is back
BREACH_CHECK=on
BREACH_FAIL_MODE=open

# Production only: set when running behind a reverse proxy (Render, Nginx...) so rate limiting sees real IPs
# TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------
# Email verification + forgot password (6-digit codes sent by email)
# ---------------------------------------------------------------------------------------------
# on  = a new account must enter the emailed code before it can sign in (default)
# off = accounts are active immediately (forgot-password still works)
REQUIRE_EMAIL_VERIFICATION=on
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SEC=60

# HOW CODES ARE DELIVERED (MAIL_MODE)
#  - inbox   (DEFAULT while developing) -> NO email is sent anywhere. Emails appear on a pretend mailbox page
#            inside the app (the "Dev Inbox" button in the top bar, or http://localhost:3000/#/inbox).
#            No account, no internet, no setup needed. Never available in production.
#  - console -> the code is printed in the server terminal.
#  - smtp    -> real emails (set SMTP_USER + SMTP_PASS; Gmail steps are in README.md). Used automatically
#               when SMTP_USER is filled in.
# MAIL_MODE=inbox
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop     <- a Google "App Password" (spaces are fine), NOT your Gmail password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=AuraAuth <your.address@gmail.com>

# Secret used to HMAC the stored codes. If empty, one is generated and saved in server/data/secret.key
# APP_SECRET=

# ---------------------------------------------------------------------------------------------
# DEMO MODE (for a public coursework demo with NO email service)
# ---------------------------------------------------------------------------------------------
# on = codes are shown ON SCREEN instead of being emailed, so "Forgot password?" can be demonstrated online.
# WARNING: anyone can then reset ANY account's password. Never use it for real users.
# DEMO_SHOW_CODES=on

# At sign-up the e-mail domain is looked up in DNS (does it exist and accept mail?). Needs internet.
# Turn it off only if you are working offline.
# EMAIL_DNS_CHECK=off

